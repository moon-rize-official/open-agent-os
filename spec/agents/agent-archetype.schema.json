{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moon-rize-official.github.io/open-agent-os/spec/agents/agent-archetype.schema.json",
  "title": "Open Agent OS Agent Archetype",
  "type": "object",
  "required": ["id", "department", "role_family", "capability_level", "authority", "provenance"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "department": {"type": "string", "minLength": 1},
    "role_family": {
      "type": "string",
      "enum": [
        "strategy-planning",
        "analysis-research",
        "implementation-delivery",
        "operations-reliability",
        "verification-governance",
        "knowledge-coordination"
      ]
    },
    "capability_level": {"type": "string", "enum": ["L0", "L1", "L2", "L3", "L4", "L5"]},
    "authority": {
      "type": "object",
      "required": ["max_risk"],
      "properties": {
        "max_risk": {"type": "string", "enum": ["R0", "R1", "R2", "R3", "R4"]},
        "production_mutation": {"type": "boolean"},
        "secrets": {"type": "string"}
      },
      "additionalProperties": true
    },
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "provenance": {
      "type": "object",
      "required": ["classification"],
      "properties": {
        "classification": {"type": "string", "enum": ["OBSERVED", "INFERENCE", "PROPOSAL"]},
        "source": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
